<body>
  <h1>New Comment</h1>

  <% if turbo_frame_request? %>
    <%= turbo_frame_tag "new_product_comment" do %>
      <%= render "form", comment: @comment %>
    <% end %>
  <% else %>
    <%= render "form", comment: @comment %>
  <% end %>
  
  <%= link_to "Cancel", product_path(@comment.product_id) %>
</body>
